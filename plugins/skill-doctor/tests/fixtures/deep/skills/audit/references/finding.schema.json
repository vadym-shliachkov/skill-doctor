{
  "type": "object",
  "required": ["rule", "severity", "evidence"],
  "properties": {
    "rule": { "type": "string", "description": "Rule key, area.name" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["file", "url"] },
          "ref": { "type": "string" }
        }
      }
    }
  }
}
